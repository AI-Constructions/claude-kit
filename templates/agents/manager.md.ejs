<% } %>
| Performance issue | qa (performance mode) → <%= modules.backend ? 'backend and/or ' : '' %><%= (modules.mobile || modules.web) ? 'frontend' : '' %> |
<% if (modules.backend && (modules.mobile || modules.web)) { %>
