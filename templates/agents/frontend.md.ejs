### Web (<%= webFramework === 'react-vite-tailwind' ? 'React + Vite + Tailwind CSS' : webFramework === 'nextjs' ? 'Next.js' : webFramework === 'nuxtjs' ? 'Nuxt.js' : webFramework === 'svelte' ? 'SvelteKit' : 'Web' %>)

